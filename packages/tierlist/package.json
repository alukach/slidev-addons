  "description": "A drag-and-drop S–F tier list for Slidev, linking to detail slides with tier badges.",
  "keywords": [
    "slidev-addon",
    "slidev"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alukach/slidev-addons.git",
    "directory": "packages/tierlist"
  },
  "homepage": "https://alukach.github.io/slidev-addons/tierlist/",
  "type": "module",
  "files": [
    "components",
    "layouts",
    "store.ts"
  ],
  "engines": {
    "slidev": ">=53.0.0"
  },
  "dependencies": {
